# URL de conexão com o banco de dados que o Prisma utiliza
# Substitua pelos valores configurados no seu ambiente local
DATABASE_URL=postgresql://seu_usuario:sua_senha@localhost:5432/nome_do_banco?schema=public

# Configuração local do chatbot OpenAI (mantida fora do GitHub)
OPENAI_API_KEY=cole_sua_chave_local_aqui
OPENAI_MODEL=gpt-4o-mini